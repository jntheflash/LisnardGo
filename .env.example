# =============================================================================
# Variables d'environnement — copier ce fichier vers .env et renseigner les valeurs.
# Ne JAMAIS committer le fichier .env (il est ignoré par git).
# =============================================================================

# --- Frontend (exposées au navigateur, préfixe VITE_ obligatoire) ------------
# Tableau de bord Supabase → Project Settings → API
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé des tuiles du fond de carte CARTO Voyager.
# Gratuite (5 M requêtes de tuiles / mois), sans compte à créer :
#   https://carto.com/basemaps/apikey/
# Laisser vide fait apparaître un filigrane « API KEY REQUIRED » sur la carte.
VITE_MAP_TILES_KEY=

# --- Script d'import (scripts/import-panneaux.ts) ----------------------------
# Utilise la clé "service_role" (NE JAMAIS l'exposer côté client / navigateur).
# Tableau de bord Supabase → Project Settings → API → service_role secret
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# --- Edge Functions (secrets côté serveur, PAS lus par Vite) -----------------
# URL publique de l'application. Utilisée par la fonction `invite-member` comme
# cible de redirection dans l'e-mail d'invitation.
#
# Cette variable ne se configure PAS via ce fichier .env : elle doit être posée
# comme secret de fonction sur le projet Supabase —
#   supabase secrets set APP_URL=https://mon-app.exemple.fr
# (ou Dashboard → Edge Functions → Secrets). Elle est reprise ici pour mémoire.
APP_URL=https://mon-app.exemple.fr
